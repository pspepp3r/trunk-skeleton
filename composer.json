{
    "name": "trunk/skeleton",
    "description": "A skeleton API application using the Trunk async PHP framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "trunk/core": "^0.1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "react/async": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php trunk key:generate"
        ]
    }
}
